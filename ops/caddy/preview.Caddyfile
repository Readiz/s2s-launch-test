http://sbox.dev.readiz.com {
	redir https://sbox.dev.readiz.com{uri} 308
}

sbox.dev.readiz.com {
	header {
		X-Robots-Tag "noindex, nofollow"
		X-Content-Type-Options "nosniff"
		Cache-Control "no-store"
	}
	@robots {
		method GET HEAD
		path /robots.txt
	}
	header @robots Content-Type "text/plain; charset=utf-8"
	respond @robots "User-agent: *\nDisallow: /\n" 200
	reverse_proxy 127.0.0.1:4491 {
		flush_interval -1
	}
}
